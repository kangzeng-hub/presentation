# Presentation System environment (copy to .env; never commit .env)

# Formal FastAPI backend (used by the React UI)
HOST=0.0.0.0                 # backend bind address
PORT=8000                    # FastAPI port
VITE_API_BASE_URL=http://localhost:8000  # browser-reachable API URL
PRESENTATION_DB_PATH=output/workspace.sqlite3 # SQLite runtime path

# Real competitor ingestion (optional; demo uses deterministic mock data)
APIFY_API_TOKEN=             # required only for live Amazon ingestion
APIFY_PRODUCT_ACTOR=junglee/amazon-product-scraper
APIFY_REVIEWS_ACTOR=junglee/amazon-reviews-scraper

# Image generation providers (optional; required only when selected)
DASHSCOPE_API_KEY=           # Wan / Qwen-VL
OPENAI_API_KEY=              # OpenAI-compatible image endpoint
SUB2API_API_KEY=             # alternative OpenAI-compatible key
OPENAI_BASE_URL=             # optional endpoint override
SUB2API_BASE_URL=             # optional endpoint override

# Optional video provider
ARK_API_KEY=
SEEDANCE_MODEL_ID=doubao-seedance-2-5-260628
SEEDANCE_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks

# Opt-in external integration test
RUN_WAN_INTEGRATION=0
