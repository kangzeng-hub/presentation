{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/image_template.json",
  "title": "ImageTemplate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_id",
    "role_id",
    "layout",
    "result",
    "style",
    "product_reference",
    "style_reference",
    "layout_reference",
    "model_layer",
    "information_layer",
    "renderer_policy",
    "generation_constraints",
    "acceptance_checks",
    "source_basis"
  ],
  "properties": {
    "template_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]+$"
    },
    "role_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]+$"
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canvas", "major_regions", "subject_location", "text_location", "information_hierarchy", "whitespace", "visual_density", "relative_proportions"],
      "properties": {
        "canvas": {"type": "string", "minLength": 1},
        "major_regions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "subject_location": {"type": "string", "minLength": 1},
        "text_location": {"type": "string", "minLength": 1},
        "information_hierarchy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "whitespace": {"type": "string", "minLength": 1},
        "visual_density": {"type": "string", "enum": ["low", "medium", "high"]},
        "relative_proportions": {"type": "string", "minLength": 1}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_should_see", "product_state", "required_relationships", "required_visual_evidence"],
      "properties": {
        "user_should_see": {"type": "string", "minLength": 1},
        "product_state": {"type": "string", "minLength": 1},
        "required_relationships": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_visual_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera_feel", "lighting", "background", "color_treatment", "realism", "commercial_character"],
      "properties": {
        "camera_feel": {"type": "string", "minLength": 1},
        "lighting": {"type": "string", "minLength": 1},
        "background": {"type": "string", "minLength": 1},
        "color_treatment": {"type": "string", "minLength": 1},
        "realism": {"type": "string", "minLength": 1},
        "commercial_character": {"type": "string", "minLength": 1}
      }
    },
    "product_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "required_assets", "identity_source", "forbidden_identity_sources"],
      "properties": {
        "policy": {
          "type": "string",
          "enum": ["CANONICAL_PRODUCT", "LAYOUT_REFERENCE", "STYLE_REFERENCE", "INFORMATION_REFERENCE"]
        },
        "required_assets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "identity_source": {"type": "string", "minLength": 1},
        "forbidden_identity_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "style_reference": {"type": "string", "minLength": 1},
    "layout_reference": {"type": "string", "minLength": 1},
    "model_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "required", "crop", "task", "product_scale", "product_identity_proof"],
      "properties": {
        "policy_id": {"type": "string", "enum": ["NONE", "PRODUCT_PROOF_MODEL", "STYLE_MODEL", "LIFESTYLE_MODEL"]},
        "required": {"type": "boolean"},
        "crop": {"type": "string", "minLength": 1},
        "task": {"type": "string", "minLength": 1},
        "product_scale": {"type": "string", "minLength": 1},
        "product_identity_proof": {"type": "boolean"}
      }
    },
    "information_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_text", "text_rendering", "data_policy", "forbidden_content"],
      "properties": {
        "allowed_text": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "text_rendering": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["content_type", "mode", "source_requirement"],
            "properties": {
              "content_type": {"type": "string", "minLength": 1},
              "mode": {"type": "string", "enum": ["programmatic", "generative"]},
              "source_requirement": {"type": "string", "minLength": 1}
            }
          }
        },
        "data_policy": {"type": "string", "minLength": 1},
        "forbidden_content": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "renderer_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "asset_stage", "generation_stage", "text_stage"],
      "properties": {
        "mode": {"type": "string", "minLength": 1},
        "asset_stage": {"type": "string", "minLength": 1},
        "generation_stage": {"type": "string", "minLength": 1},
        "text_stage": {"type": "string", "minLength": 1}
      }
    },
    "generation_constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "acceptance_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "source", "note"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["competitor_visual_fact", "inference", "existing_strategy_requirement"]
          },
          "source": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
