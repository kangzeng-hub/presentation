{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/reference_policy.json",
  "title": "ReferencePolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "purpose", "allowed_effect", "forbidden_effect", "source_types"],
  "properties": {
    "policy_id": {
      "type": "string",
      "enum": [
        "CANONICAL_PRODUCT",
        "LAYOUT_REFERENCE",
        "STYLE_REFERENCE",
        "INFORMATION_REFERENCE",
        "COMPETITOR_PRODUCT_IDENTITY"
      ]
    },
    "purpose": {"type": "string", "minLength": 1},
    "allowed_effect": {"type": "array", "minItems": 0, "items": {"type": "string", "minLength": 1}},
    "forbidden_effect": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
